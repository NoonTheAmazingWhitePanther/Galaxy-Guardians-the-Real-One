{
  "panels": [
    {
      "id": "governor",
      "title": "GOVERNOR",
      "position": {
        "x": 16,
        "y": 80
      },
      "refreshRate": 250,
      "minimized": false,
      "summaryVariable": "GovernorProfiles.label",
      "summaryLabel": "Profile",
      "lines": [
        {
          "type": "header",
          "text": "GOVERNOR",
          "value": "GovernorProfiles.label",
          "color": "accent",
          "bold": true
        },
        {
          "type": "divider",
          "text": "— select profile —"
        },
        {
          "type": "profileButtons",
          "buttons": [
            {
              "label": "MAX",
              "profile": "MAX"
            },
            {
              "label": "BALANCE",
              "profile": "BALANCE"
            },
            {
              "label": "MIN",
              "profile": "MIN"
            },
            {
              "label": "AUTO",
              "profile": null
            }
          ]
        },
        {
          "type": "divider",
          "text": "— current —"
        },
        {
          "type": "display",
          "text": "profile",
          "value": "GovernorProfiles.label"
        },
        {
          "type": "display",
          "text": "frame skip",
          "value": "ManualOverrides.renderFrameSkip.value"
        },
        {
          "type": "display",
          "text": "substeps",
          "value": "ManualOverrides.physicsSubsteps.value"
        },
        {
          "type": "display",
          "text": "que budget",
          "value": "ManualOverrides.queOpsBudget.value"
        },
        {
          "type": "display",
          "text": "cache",
          "value": "ManualOverrides.cacheVaultSize.value"
        }
      ],
      "maxHeight": 360,
      "background": null
    },
    {
      "id": "fps",
      "title": "FPS",
      "position": {
        "x": 16,
        "y": 140
      },
      "refreshRate": 500,
      "minimized": true,
      "summaryVariable": "FpsCounter.debugInfo.real",
      "summaryLabel": "fps",
      "lines": [
        {
          "type": "header",
          "text": "FPS",
          "value": "FpsCounter.debugInfo.real",
          "color": "accent",
          "bold": true
        },
        {
          "type": "divider",
          "text": "— real fps —"
        },
        {
          "type": "display",
          "text": "now",
          "value": "FpsCounter.debugInfo.real"
        },
        {
          "type": "display",
          "text": "avg",
          "value": "FpsCounter.debugInfo.avgReal"
        },
        {
          "type": "display",
          "text": "min",
          "value": "FpsCounter.debugInfo.min"
        },
        {
          "type": "display",
          "text": "max",
          "value": "FpsCounter.debugInfo.max"
        },
        {
          "type": "divider",
          "text": "— virtual fps (skip × real) —"
        },
        {
          "type": "display",
          "text": "virtual now",
          "value": "FpsCounter.debugInfo.virtual"
        },
        {
          "type": "display",
          "text": "virtual avg",
          "value": "FpsCounter.debugInfo.avgVirtual"
        },
        {
          "type": "divider",
          "text": "— renderer —"
        },
        {
          "type": "display",
          "text": "frame skip",
          "value": "FpsCounter.debugInfo.frameSkip"
        },
        {
          "type": "display",
          "text": "mode",
          "value": "FpsCounter.debugInfo.skipLabel"
        },
        {
          "type": "display",
          "text": "total frames",
          "value": "FpsCounter.debugInfo.totalFrames"
        },
        {
          "type": "divider",
          "text": "— render skip control —"
        },
        {
          "type": "buttons",
          "text": "Frame Skip",
          "variable": "ManualOverrides.renderFrameSkip.value",
          "buttons": [
            "+",
            "=",
            "−"
          ],
          "governor": {
            "mode": "add",
            "min": 0,
            "max": 10,
            "step": 1
          }
        }
      ],
      "minimizedKnob": {
        "variable": "ManualOverrides.renderFrameSkip.value",
        "min": 0,
        "max": 10,
        "step": 1,
        "label": "Skip",
        "integer": true
      },
      "summaryExtra": "FpsCounter.debugInfo.skipLabel",
      "maxHeight": 280,
      "background": null
    },
    {
      "id": "drawCalls",
      "title": "DRAW CALLS",
      "position": {
        "x": 16,
        "y": 200
      },
      "refreshRate": 100,
      "summaryVariable": "DrawCallCounter.total",
      "summaryLabel": "draw calls",
      "lines": [
        {
          "type": "header",
          "text": "DRAW CALLS",
          "value": "DrawCallCounter.total",
          "color": "accent",
          "bold": true
        },
        {
          "type": "display",
          "text": "total draws",
          "value": "DrawCallCounter.total"
        },
        {
          "type": "display",
          "text": "total path ops",
          "value": "DrawCallCounter.pathOps"
        },
        {
          "type": "sectionHeader",
          "key": "method totals",
          "text": "method totals",
          "totalSource": "DrawCallCounter.methodTotals"
        },
        {
          "type": "displayMap",
          "source": "DrawCallCounter.methodTotals",
          "filter": "positive",
          "sort": "desc"
        },
        {
          "type": "sectionHeader",
          "key": "per pass",
          "text": "per pass",
          "totalSource": "DrawCallCounter.total"
        },
        {
          "type": "groupedDisplayMap",
          "key": "pass",
          "source": "DrawCallCounter.passRows",
          "separator": " ∙ ",
          "filter": "positive",
          "sortGroups": "desc",
          "collapsedByDefault": true
        }
      ],
      "minimized": true,
      "maxHeight": 280,
      "collapsedByDefault": [
        "method totals",
        "per pass"
      ],
      "background": null
    },
    {
      "id": "physics",
      "title": "PHYSICS",
      "position": {
        "x": 16,
        "y": 260
      },
      "refreshRate": 100,
      "summaryVariable": "PhysicsGov.timeScale",
      "summaryLabel": "Time Scale",
      "lines": [
        {
          "type": "header",
          "text": "PHYSICS",
          "value": "PhysicsCounter.total",
          "suffix": "PhysicsGov.label",
          "color": "accent",
          "bold": true
        },
        {
          "type": "divider",
          "text": "— governor —"
        },
        {
          "type": "display",
          "text": "substeps",
          "value": "PhysicsGov.substepLabel"
        },
        {
          "type": "display",
          "text": "time scale",
          "value": "PhysicsGov.timeScale"
        },
        {
          "type": "display",
          "text": "mode",
          "value": "PhysicsGov.label"
        },
        {
          "type": "divider",
          "text": "— per frame counts —"
        },
        {
          "type": "displayMap",
          "source": "PhysicsCounter.stats",
          "labels": "PhysicsCounter._labels",
          "filter": "positive"
        },
        {
          "type": "display",
          "text": "total ops",
          "value": "PhysicsCounter.total"
        },
        {
          "type": "divider",
          "text": "— controls —"
        },
        {
          "type": "buttons",
          "text": "Time Scale",
          "variable": "ManualOverrides.physicsTimeScale.value",
          "buttons": [
            "×",
            "=",
            "÷"
          ],
          "governor": {
            "mode": "mult",
            "min": 0.25,
            "max": 4
          }
        },
        {
          "type": "buttons",
          "text": "Substeps",
          "variable": "ManualOverrides.physicsSubsteps.value",
          "buttons": [
            "+",
            "=",
            "−"
          ],
          "governor": {
            "mode": "add",
            "min": 1,
            "max": 16,
            "step": 1
          }
        }
      ],
      "minimized": true,
      "maxHeight": 280,
      "background": null
    },
    {
      "id": "queops",
      "title": "QUEUE OPS",
      "position": {
        "x": 159,
        "y": 80
      },
      "refreshRate": 250,
      "summaryVariable": "QueOps.budget",
      "summaryLabel": "Budget",
      "lines": [
        {
          "type": "header",
          "text": "QUEUE OPS",
          "value": "QueOps.queueSize",
          "suffix": "QueOps.label",
          "color": "accent",
          "bold": true
        },
        {
          "type": "display",
          "text": "queue size",
          "value": "QueOps.queueSize"
        },
        {
          "type": "display",
          "text": "budget",
          "value": "QueOps.budget"
        },
        {
          "type": "display",
          "text": "budget used",
          "value": "QueOps.budgetUsed"
        },
        {
          "type": "display",
          "text": "cooling",
          "value": "QueOps.coolingState"
        },
        {
          "type": "display",
          "text": "mode",
          "value": "QueOps.label"
        },
        {
          "type": "divider",
          "text": "— per frame ops —"
        },
        {
          "type": "display",
          "text": "processed",
          "value": "QueOps.opsProcessed"
        },
        {
          "type": "display",
          "text": "deferred",
          "value": "QueOps.opsDeferred"
        },
        {
          "type": "display",
          "text": "skipped",
          "value": "QueOps.opsSkipped"
        },
        {
          "type": "display",
          "text": "staggered",
          "value": "QueOps.opsStaggered"
        },
        {
          "type": "divider",
          "text": "— trails —"
        },
        {
          "type": "display",
          "text": "trail depth",
          "value": "Accumulator.trailDepth"
        },
        {
          "type": "display",
          "text": "fade alpha",
          "value": "Accumulator.fadeAlpha"
        },
        {
          "type": "divider",
          "text": "— config —"
        },
        {
          "type": "display",
          "text": "delay ms",
          "value": "QueOps.config.defaultDelayMs"
        },
        {
          "type": "display",
          "text": "stagger",
          "value": "QueOps.config.enableStagger",
          "format": "onoff"
        },
        {
          "type": "display",
          "text": "max frame ms",
          "value": "QueOps.config.maxFrameTimeMs"
        },
        {
          "type": "divider",
          "text": "— controls —"
        },
        {
          "type": "buttons",
          "text": "Budget",
          "variable": "ManualOverrides.queOpsBudget.value",
          "buttons": [
            "×",
            "=",
            "÷"
          ],
          "governor": {
            "mode": "mult",
            "steps": [
              16,
              32,
              64,
              128,
              256
            ]
          }
        },
        {
          "type": "buttons",
          "text": "Delay",
          "variable": "ManualOverrides.queOpsDelay.value",
          "buttons": [
            "+",
            "=",
            "−"
          ],
          "governor": {
            "mode": "add",
            "min": 0,
            "max": 5,
            "step": 0.1
          }
        },
        {
          "type": "buttons",
          "text": "Defer threshold",
          "variable": "ManualOverrides.queOpsDeferredThreshold.value",
          "buttons": [
            "+",
            "=",
            "−"
          ],
          "governor": {
            "mode": "add",
            "min": 10,
            "max": 200,
            "step": 10
          }
        }
      ],
      "minimized": true,
      "maxHeight": 280,
      "background": null
    },
    {
      "id": "msProbe",
      "title": "MS PROBE",
      "position": {
        "x": 159,
        "y": 140
      },
      "refreshRate": 250,
      "summaryVariable": "MsProbe.topAvg",
      "summaryLabel": "Slowest avg ms",
      "lines": [
        {
          "type": "header",
          "text": "MS PROBE",
          "value": "MsProbe.topAvg",
          "suffix": "MsProbe.topLabel",
          "color": "accent",
          "bold": true
        },
        {
          "type": "divider",
          "text": "— last ms / avg ms / max ms —"
        },
        {
          "type": "msProbeRow",
          "label": "physics.tick"
        },
        {
          "type": "msProbeRow",
          "label": "render.drawAll"
        },
        {
          "type": "msProbeRow",
          "label": "render.accumulator"
        },
        {
          "type": "msProbeRow",
          "label": "queops.tick"
        }
      ],
      "minimized": true,
      "maxHeight": 280,
      "background": null
    },
    {
      "id": "stateCache",
      "title": "STATE CACHE",
      "position": {
        "x": 159,
        "y": 200
      },
      "refreshRate": 250,
      "summaryVariable": "StateCache.debugInfo.fill",
      "summaryLabel": "Vault fill",
      "lines": [
        {
          "type": "header",
          "text": "STATE CACHE",
          "value": "StateCache.debugInfo.fill",
          "suffix": "StateCache.debugInfo.ready",
          "color": "accent",
          "bold": true
        },
        {
          "type": "display",
          "text": "vault used",
          "value": "StateCache.debugInfo.used"
        },
        {
          "type": "display",
          "text": "vault max",
          "value": "StateCache.debugInfo.max"
        },
        {
          "type": "display",
          "text": "fill",
          "value": "StateCache.debugInfo.fill"
        },
        {
          "type": "display",
          "text": "ready",
          "value": "StateCache.debugInfo.ready",
          "format": "onoff"
        },
        {
          "type": "divider",
          "text": "— last snapshot —"
        },
        {
          "type": "display",
          "text": "bodies",
          "value": "StateCache.debugInfo.bodies"
        },
        {
          "type": "display",
          "text": "loose",
          "value": "StateCache.debugInfo.loose"
        }
      ],
      "minimized": true,
      "maxHeight": 280,
      "background": null
    },
    {
      "id": "aim",
      "title": "AIM CURSOR",
      "position": {
        "x": 159,
        "y": 260
      },
      "refreshRate": 16,
      "summaryVariable": "Aims.debugInfo.effective",
      "summaryLabel": "Effective",
      "lines": [
        {
          "type": "header",
          "text": "AIM CURSOR",
          "value": "Aims.debugInfo.effective",
          "suffix": "Aims.debugInfo.guardianState",
          "color": "accent",
          "bold": true
        },
        {
          "type": "display",
          "text": "effective",
          "value": "Aims.debugInfo.effective"
        },
        {
          "type": "display",
          "text": "offset X",
          "value": "Aims.debugInfo.offsetX"
        },
        {
          "type": "display",
          "text": "offset Y",
          "value": "Aims.debugInfo.offsetY"
        },
        {
          "type": "display",
          "text": "radius",
          "value": "Aims.debugInfo.radius"
        },
        {
          "type": "display",
          "text": "map scale",
          "value": "Aims.debugInfo.mapScale"
        },
        {
          "type": "display",
          "text": "map size",
          "value": "Aims.debugInfo.mapSize"
        },
        {
          "type": "display",
          "text": "map KB",
          "value": "Aims.debugInfo.mapKB"
        },
        {
          "type": "display",
          "text": "items",
          "value": "Aims.debugInfo.items"
        },
        {
          "type": "display",
          "text": "layers",
          "value": "Aims.debugInfo.layers"
        },
        {
          "type": "display",
          "text": "AIMS",
          "value": "Aims.debugInfo.aimsState"
        },
        {
          "type": "slider",
          "text": "Offset X",
          "variable": "Aims.aim.offsetX",
          "min": -200,
          "max": 200,
          "step": 1
        },
        {
          "type": "slider",
          "text": "Offset Y",
          "variable": "Aims.aim.offsetY",
          "min": -200,
          "max": 200,
          "step": 1
        },
        {
          "type": "knob",
          "text": "Radius",
          "variable": "Aims.aim.radius",
          "min": 5,
          "max": 100,
          "step": 1
        }
      ],
      "minimized": true,
      "maxHeight": 280,
      "background": null
    }
  ]
}