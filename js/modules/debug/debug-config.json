{
  "panels": [
  {
    "id": "drawCalls",
    "title": "DRAW CALLS",
    "position": { "x": 16, "y": 80 },
    "refreshRate": 100,
    "summaryVariable": "RenderGov.frameSkip",
    "summaryLabel": "Frame Skip",
    "lines": [
    {
      "type": "header",
      "text": "DRAW CALLS",
      "value": "DrawCallCounter.total",
      "suffix": "RenderGov.label",
      "color": "accent",
      "bold": true
    },
    {
      "type": "display",
      "text": "path ops",
      "value": "DrawCallCounter.pathOps"
    },
    {
      "type": "display",
      "text": "Frame Skip",
      "value": "RenderGov.frameSkip"
    },
    {
      "type": "buttons",
      "text": "Frame Skip",
      "variable": "ManualOverrides.renderFrameSkip.value",
      "buttons": ["+", "=", "−"],
      "governor": { "mode": "add", "min": 0, "max": 10, "step": 1 }
    }]
  },
  {
    "id": "physics",
    "title": "PHYSICS",
    "position": { "x": 16, "y": 220 },
    "refreshRate": 100,
    "summaryVariable": "PhysicsGov.timeScale",
    "summaryLabel": "Time Scale",
    "lines": [
    {
      "type": "header",
      "text": "PHYSICS",
      "value": "PhysicsCounter.total",
      "suffix": "PhysicsGov.label",
      "color": "accent",
      "bold": true
    },
    {
      "type": "display",
      "text": "substeps",
      "value": "PhysicsGov.substepLabel"
    },
    {
      "type": "displayMap",
      "source": "PhysicsCounter.stats",
      "labels": "PhysicsCounter._labels",
      "filter": "positive"
    },
    {
      "type": "buttons",
      "text": "Time Scale",
      "variable": "ManualOverrides.physicsTimeScale.value",
      "buttons": ["✕", "=", "÷"],
      "governor": { "mode": "mult", "min": 0.25, "max": 4 }
    },
    {
      "type": "buttons",
      "text": "Substeps",
      "variable": "ManualOverrides.physicsSubsteps.value",
      "buttons": ["+", "=", "−"],
      "governor": { "mode": "add", "min": 1, "max": 16, "step": 1 }
    }]
  },
  {
    "id": "queops",
    "title": "QUEUE OPS",
    "position": { "x": 16, "y": 450 },
    "refreshRate": 200,
    "summaryVariable": "QueOps.budget",
    "summaryLabel": "Budget",
    "lines": [
    {
      "type": "header",
      "text": "QUEUE OPS",
      "value": "QueOps.queueSize",
      "suffix": "QueOps.label",
      "color": "accent",
      "bold": true
    },
    {
      "type": "display",
      "text": "fps",
      "value": "QueOps.fps"
    },
    {
      "type": "display",
      "text": "cooling",
      "value": "QueOps.coolingState"
    },
    {
      "type": "display",
      "text": "processed",
      "value": "QueOps.opsProcessed"
    },
    {
      "type": "display",
      "text": "deferred",
      "value": "QueOps.opsDeferred"
    },
    {
      "type": "display",
      "text": "skipped",
      "value": "QueOps.opsSkipped"
    },
    {
      "type": "divider",
      "text": "— stagger —"
    },
    {
      "type": "display",
      "text": "delay",
      "value": "QueOps.config.defaultDelayMs",
      "format": "ms"
    },
    {
      "type": "display",
      "text": "stagger",
      "value": "QueOps.config.enableStagger",
      "format": "onoff"
    },
    {
      "type": "divider",
      "text": "— trails —"
    },
    {
      "type": "display",
      "text": "depth",
      "value": "Accumulator.depth"
    },
    {
      "type": "display",
      "text": "fade",
      "value": "Accumulator.fade"
    },
    {
      "type": "divider",
      "text": "— guardian —"
    },
    {
      "type": "display",
      "text": "guardian",
      "value": "Aims.debugInfo.guardianState"
    },
    {
      "type": "display",
      "text": "Budget",
      "value": "QueOps.label"
    },
    {
      "type": "buttons",
      "text": "Budget",
      "variable": "ManualOverrides.queOpsBudget.value",
      "buttons": ["✕", "=", "÷"],
      "governor": { "mode": "mult", "steps": [16, 32, 64, 128, 256] }
    },
    {
      "type": "buttons",
      "text": "Delay",
      "variable": "ManualOverrides.queOpsDelay.value",
      "buttons": ["+", "=", "−"],
      "governor": { "mode": "add", "min": 0, "max": 5, "step": 0.1 }
    },
    {
      "type": "buttons",
      "text": "Thresholds",
      "variable": "ManualOverrides.queOpsDeferredThreshold.value",
      "buttons": ["+", "=", "−"],
      "governor": { "mode": "add", "min": 10, "max": 200, "step": 10 }
    }]
  },
  {
    "id": "aim",
    "title": "AIM CURSOR",
    "position": { "x": 280, "y": 80 },
    "refreshRate": 16,
    "summaryVariable": "Aims.debugInfo.effective",
    "summaryLabel": "Effective",
    "lines": [
    {
      "type": "header",
      "text": "AIM CURSOR",
      "value": "Aims.debugInfo.effective",
      "suffix": "Aims.debugInfo.guardianState",
      "color": "accent",
      "bold": true
    },
    {
      "type": "display",
      "text": "effective",
      "value": "Aims.debugInfo.effective"
    },
    {
      "type": "display",
      "text": "offset X",
      "value": "Aims.debugInfo.offsetX"
    },
    {
      "type": "display",
      "text": "offset Y",
      "value": "Aims.debugInfo.offsetY"
    },
    {
      "type": "display",
      "text": "radius",
      "value": "Aims.debugInfo.radius"
    },
    {
      "type": "display",
      "text": "map scale",
      "value": "Aims.debugInfo.mapScale"
    },
    {
      "type": "display",
      "text": "map size",
      "value": "Aims.debugInfo.mapSize"
    },
    {
      "type": "display",
      "text": "map KB",
      "value": "Aims.debugInfo.mapKB"
    },
    {
      "type": "display",
      "text": "items",
      "value": "Aims.debugInfo.items"
    },
    {
      "type": "display",
      "text": "layers",
      "value": "Aims.debugInfo.layers"
    },
    {
      "type": "display",
      "text": "AIMS",
      "value": "Aims.debugInfo.aimsState"
    },
    {
      "type": "slider",
      "text": "Offset X",
      "variable": "Aims.aim.offsetX",
      "min": -200,
      "max": 200,
      "step": 1
    },
    {
      "type": "slider",
      "text": "Offset Y",
      "variable": "Aims.aim.offsetY",
      "min": -200,
      "max": 200,
      "step": 1
    },
    {
      "type": "knob",
      "text": "Radius",
      "variable": "Aims.aim.radius",
      "min": 5,
      "max": 100,
      "step": 1
    }]
  }]
}